{
  "name": "mcp-game-deck-server",
  "version": "1.0.0",
  "description": "MCP proxy bundled with MCP Game Deck — translates STDIO MCP requests from Claude Code into HTTP JSON-RPC calls against the in-Unity C# MCP server. Compiled to a self-contained CJS bundle and shipped inside the Tauri app's resource directory.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-game-deck": "./dist/mcp-proxy.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle:proxy": "esbuild src/mcp-proxy.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/mcp-proxy.cjs",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-proxy.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
